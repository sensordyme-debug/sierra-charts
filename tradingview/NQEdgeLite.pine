//@version=5
// ============================================================================
//  NQ Edge Lite 2.0 — the NQ Edge system for TradingView (live data)
//  Directional Conviction Score from VWAP, structure, multi-timeframe bias, tick-rule delta / CVD,
//  absorption, trapped traders, CVD divergence, the session value area, prior-day / overnight / IB /
//  prior-week levels, ES relative strength and NYSE TICK. Five setups with structural stops,
//  liquidity targets, A/B grades and $-risk size. Every A/B signal is tracked forward (stop first,
//  then T1); the expectancy gate mutes any setup whose running average R is negative.
//  Decisions on CLOSED bars only: create alerts with "Once Per Bar Close".
//  Chart: CME_MINI:NQ1! or MNQ1!, 2- to 5-minute bars, dark theme. docs/TRADINGVIEW.md lists the
//  chart settings that make it look right.
// ============================================================================
indicator("NQ Edge Lite", "NQ Edge", overlay=true, max_lines_count=200, max_labels_count=250, max_boxes_count=150, max_bars_back=2000)

// ═════════════════════════ Inputs ═════════════════════════
gS = "Session (New York time)"
rthStartH = input.int(9,  "RTH start hour",   minval=0, maxval=23, group=gS, display=display.none)
rthStartM = input.int(30, "RTH start minute", minval=0, maxval=59, group=gS, display=display.none)
rthEndH   = input.int(16, "RTH end hour",     minval=0, maxval=23, group=gS, display=display.none)
dayStartH = input.int(18, "Trading day start hour (evening open)", minval=0, maxval=23, group=gS, display=display.none)
ibMin     = input.int(60, "Initial balance minutes", minval=5, maxval=240, group=gS, display=display.none)
winStartH = input.int(10, "Trade window start hour",   minval=0, maxval=23, group=gS, display=display.none)
winStartM = input.int(0,  "Trade window start minute", minval=0, maxval=59, group=gS, display=display.none)
winEndH   = input.int(15, "Trade window end hour",     minval=0, maxval=23, group=gS, display=display.none)
winEndM   = input.int(30, "Trade window end minute",   minval=0, maxval=59, group=gS, display=display.none)
rthOnly   = input.bool(true, "Signals only during RTH", group=gS, display=display.none)

gF = "Order flow"
ltfStr      = input.string("1", "Lower timeframe for delta (1 = one minute)", group=gF, display=display.none)
absZ        = input.float(2.0, "Absorption: volume z >=", minval=0.5, maxval=10, step=0.1, group=gF, display=display.none)
volZLen     = input.int(50, "Volume z-score length", minval=10, maxval=500, group=gF, display=display.none)
cvdResetRth = input.bool(true, "Reset CVD at RTH open (off = trading day start)", group=gF, display=display.none)

gM = "Model"
sigThr    = input.float(40, "Signal threshold |DCS|", minval=10, maxval=100, step=1, group=gM, display=display.none)
weakThr   = input.float(25, "Candle bias |DCS| >=", minval=0, maxval=100, step=1, group=gM, display=display.none)
swingN    = input.int(5, "Swing strength bars", minval=2, maxval=30, group=gM, display=display.none)
levelTol  = input.float(0.3, "Level tolerance (ATR)", minval=0.05, maxval=2, step=0.05, group=gM, display=display.none)
stopBuf   = input.float(0.5, "Stop buffer beyond structure (ATR)", minval=0, maxval=3, step=0.1, group=gM, display=display.none)
minStop   = input.float(0.6, "Min stop (ATR)", minval=0.1, maxval=3, step=0.1, group=gM, display=display.none)
maxStop   = input.float(2.5, "Max stop (ATR)", minval=0.5, maxval=10, step=0.1, group=gM, display=display.none)
minRR     = input.float(1.0, "Min R:R to T1", minval=0.5, maxval=5, step=0.1, group=gM, display=display.none)
showB     = input.bool(false, "Show grade B signals (A is always shown)", group=gM, display=display.none)
useMtf    = input.bool(true, "Trend pullbacks need multi-timeframe agreement", group=gM, display=display.none)
useRibbon = input.bool(true, "With-trend setups need the EMA ribbon aligned", group=gM, display=display.none)
gateOn    = input.bool(true, "Expectancy gate: mute setups that are losing", group=gM, display=display.none, tooltip="Every A/B signal is tracked forward (stop first, then T1, timeout 120 bars). A setup whose running average R is below the threshold after the minimum number of resolved trades is no longer shown or alerted. It keeps being tracked in the background and comes back when its record recovers.")
gateN     = input.int(15, "Gate: minimum resolved trades", minval=5, maxval=200, group=gM, display=display.none)
gateR     = input.float(0.0, "Gate: minimum average R", minval=-1, maxval=2, step=0.05, group=gM, display=display.none)
esSym     = input.symbol("CME_MINI:ES1!", "Relative-strength reference", group=gM, display=display.none)
tickSym   = input.symbol("USI:TICK", "NYSE TICK symbol", group=gM, display=display.none)
useFeeds  = input.bool(true, "Use the reference feeds (ES, TICK)", group=gM, display=display.none)

gR = "Risk"
riskUSD   = input.float(100, "Risk per trade ($)", minval=0, maxval=1000000, step=10, group=gR, display=display.none)
pointVal  = input.float(20, "Point value ($ per 1.00: NQ 20, MNQ 2, ES 50, MES 5)", minval=0.01, group=gR, display=display.none)
maxTrades = input.int(3, "Max signals per day (0 = off)", minval=0, maxval=50, group=gR, display=display.none)

gP = "Volume profile (RTH session)"
showProf  = input.bool(true, "Session volume profile", group=gP, display=display.none)
binTicks  = input.int(8, "Row size (ticks)", minval=1, maxval=400, group=gP, display=display.none)
profRows  = input.int(36, "Max rows drawn", minval=10, maxval=80, group=gP, display=display.none)
profOff   = input.int(14, "Offset right of the last bar (bars)", minval=0, maxval=300, group=gP, display=display.none)
profWidth = input.int(28, "Width (bars)", minval=5, maxval=200, group=gP, display=display.none)
vaPct     = input.float(70, "Value area %", minval=50, maxval=95, step=1, group=gP, display=display.none)

gV = "Display"
hudPos       = input.string("Top right", "Dashboard position", options=["Top right", "Top left", "Bottom left", "Bottom right"], group=gV, display=display.none)
showHud      = input.bool(true, "Dashboard", group=gV, display=display.none)
showPerf     = input.bool(true, "Performance panel", group=gV, display=display.none)
showSig      = input.bool(true, "Signal markers (hover for the plan)", group=gV, display=display.none)
showOutcomes = input.bool(true, "Trade outcomes (+R / -R)", group=gV, display=display.none)
showPosTool  = input.bool(true, "Live position: entry / stop / targets", group=gV, display=display.none)
showLevels   = input.bool(true, "Key levels with right-edge tags", group=gV, display=display.none)
levelsPer    = input.int(3, "Levels per side", minval=1, maxval=6, group=gV, display=display.none)
showTL       = input.bool(true, "Trend lines (auto, from swings)", group=gV, display=display.none)
showRibbon   = input.bool(true, "EMA ribbon (9 / 21)", group=gV, display=display.none)
showBand     = input.bool(true, "VWAP ±1σ cloud", group=gV, display=display.none)
showBand2    = input.bool(false, "VWAP ±2σ lines", group=gV, display=display.none)
showBub      = input.bool(true, "Absorption bubbles", group=gV, display=display.none)
marksMode    = input.string("Key", "Context marks", options=["Off", "Key", "All"], group=gV, display=display.none, tooltip="Key = trapped traders and CVD divergence. All adds exhaustion.")
showWin      = input.bool(true, "Tint the trade window", group=gV, display=display.none)
cBull  = input.color(#00F5A0, "Bull", group=gV)
cBear  = input.color(#FF3366, "Bear", group=gV)
cNeuUp = input.color(#56638A, "Neutral up bar", group=gV)
cNeuDn = input.color(#343D5C, "Neutral down bar", group=gV)
cVwap  = input.color(#00D4FF, "VWAP / accent", group=gV)
cBand  = input.color(#7B61FF, "Bands / profile", group=gV)
cGold  = input.color(#FFC857, "POC / value", group=gV)
cMag   = input.color(#E040FB, "Divergence", group=gV)
cText  = input.color(#E8ECF5, "Text", group=gV)
cPanel = input.color(#0A0E17, "Panel", group=gV)
cDim   = input.color(#7D879C, "Dim text", group=gV)
cPD    = #FFB547
cON    = #B388FF
cIB    = #29C5F6
cPW    = #FF6EC7
cLevel = #8FA3C7
cRow   = #121A2B
cClear = color.new(#000000, 100)
marksKey = marksMode != "Off"
marksAll = marksMode == "All"

// ═════════════════════════ Helpers ═════════════════════════
f_clamp(x) => math.max(-1.0, math.min(1.0, x))
f_sign(c, o, pc) => c > o ? 1.0 : c < o ? -1.0 : c > pc ? 1.0 : c < pc ? -1.0 : 0.0
f_px(v) => str.tostring(v, format.mintick)
f_signed(v, fmt) => (v >= 0 ? "+" : "") + str.tostring(v, fmt)
f_arrow(x) => x > 0 ? "▲" : x < 0 ? "▼" : "•"
f_hm(h, m) => str.tostring(h) + ":" + (m < 10 ? "0" : "") + str.tostring(m)
f_setupName(t) => t == 1 ? "Trend Pullback" : t == 2 ? "Value Edge" : t == 3 ? "Failed Breakout" : t == 4 ? "Break+Accept" : t == 5 ? "Divergence" : "--"
f_pos(s) => s == "Top left" ? position.top_left : s == "Bottom left" ? position.bottom_left : s == "Bottom right" ? position.bottom_right : position.top_right
f_cell(t, c, r, txt, fg, bg, sz) =>
    table.cell(t, c, r, txt, text_color=fg, bgcolor=bg, text_size=sz, text_halign=text.align_left, text_font_family=font.family_monospace)
    true

// ═════════════════════════ Time ═════════════════════════
tz = "America/New_York"
tod      = hour(time, tz) * 60 + minute(time, tz)
rthStart = rthStartH * 60 + rthStartM
rthEnd   = rthEndH * 60
dayStart = dayStartH * 60
winStart = winStartH * 60 + winStartM
winEnd   = winEndH * 60 + winEndM
inRTH    = tod >= rthStart and tod < rthEnd
prevTod  = nz(tod[1], -1)
newDay   = tod >= dayStart and (prevTod < dayStart or prevTod > tod)
prevInRTH = inRTH[1] ? true : false
rthOpen  = inRTH and not prevInRTH
inWindow = tod >= winStart and tod < winEnd
newWeek  = newDay and dayofweek(time, tz) == dayofweek.sunday
atr      = ta.atr(14)
winTxt   = f_hm(winStartH, winStartM) + "-" + f_hm(winEndH, winEndM)

// ═════════════════════════ Delta / CVD / volume ═════════════════════════
ltfOk    = timeframe.in_seconds() > timeframe.in_seconds(ltfStr)
effLtf   = ltfOk ? ltfStr : timeframe.period
deltaArr = request.security_lower_tf(syminfo.tickerid, effLtf, volume * f_sign(close, open, close[1]))
barDelta = array.size(deltaArr) > 0 ? array.sum(deltaArr) : volume * f_sign(close, open, close[1])
volMean  = ta.sma(volume, volZLen)
volSd    = ta.stdev(volume, volZLen)
volZ     = volSd > 0 ? (volume - volMean) / volSd : 0.0
deltaPct = volume > 0 ? barDelta / volume : 0.0
var float cvd = 0.0
if (cvdResetRth ? rthOpen : newDay)
    cvd := 0.0
cvd += barDelta
cvdSlope = cvd - nz(cvd[10], cvd)
csMean   = ta.sma(cvdSlope, 100)
csSd     = ta.stdev(cvdSlope, 100)
cvdZ     = csSd > 0 ? (cvdSlope - csMean) / csSd : 0.0

// ═════════════════════════ Session levels ═════════════════════════
var float rthH = na
var float rthL = na
var float pdh = na
var float pdl = na
var float pdc = na
var float lastRthClose = na
var float onH = na
var float onL = na
var float ibH = na
var float ibL = na
var bool  ibDone = false
var float cwH = na
var float cwL = na
var float pwH = na
var float pwL = na
var int   tradesToday = 0
if rthOpen
    pdh := rthH
    pdl := rthL
    pdc := lastRthClose
    rthH := high
    rthL := low
    ibH := high
    ibL := low
    ibDone := false
    tradesToday := 0
else if inRTH
    rthH := math.max(nz(rthH, high), high)
    rthL := math.min(nz(rthL, low), low)
    if tod < rthStart + ibMin
        ibH := math.max(nz(ibH, high), high)
        ibL := math.min(nz(ibL, low), low)
    else
        ibDone := true
if inRTH
    lastRthClose := close
if newDay
    onH := high
    onL := low
else if not inRTH and (tod >= dayStart or tod < rthStart)
    onH := math.max(nz(onH, high), high)
    onL := math.min(nz(onL, low), low)
if newWeek
    pwH := cwH
    pwL := cwL
    cwH := high
    cwL := low
else
    cwH := math.max(nz(cwH, high), high)
    cwL := math.min(nz(cwL, low), low)
ibHigh = ibDone ? ibH : na
ibLow  = ibDone ? ibL : na

// ═════════════════════════ Session volume profile (RTH): POC, value area ═════════════════════════
// Each RTH bar's volume is spread evenly over the rows it traded through; the value area grows from the POC
// toward the heavier neighbour until it holds vaPct of the session volume. Prior session's POC / VA are kept.
binSize  = syminfo.mintick * binTicks
PROF_N   = 2001
PROF_OFF = 1000
var profVol = array.new_float(PROF_N, 0.0)
var float profBase = na
var int   pocIdx = -1
var float pocVol = 0.0
var int   pMin = PROF_N
var int   pMax = -1
var float profTotal = 0.0
var float poc = na
var float vaHi = na
var float vaLo = na
var float pdPoc = na
var float pdVah = na
var float pdVal = na
if rthOpen
    pdPoc := poc
    pdVah := vaHi
    pdVal := vaLo
    array.fill(profVol, 0.0)
    profBase := math.round(open / binSize) * binSize
    pocIdx := -1
    pocVol := 0.0
    pMin := PROF_N
    pMax := -1
    profTotal := 0.0
    poc := na
    vaHi := na
    vaLo := na
if inRTH and not na(profBase) and volume > 0
    iLo = math.max(0, math.min(PROF_N - 1, math.round((low - profBase) / binSize) + PROF_OFF))
    iHi = math.max(0, math.min(PROF_N - 1, math.round((high - profBase) / binSize) + PROF_OFF))
    share = volume / (iHi - iLo + 1)
    for b = iLo to iHi
        nv = array.get(profVol, b) + share
        array.set(profVol, b, nv)
        if nv > pocVol
            pocVol := nv
            pocIdx := b
    pMin := math.min(pMin, iLo)
    pMax := math.max(pMax, iHi)
    profTotal += volume
    target = profTotal * vaPct / 100.0
    int lo = pocIdx
    int hi = pocIdx
    float acc = array.get(profVol, pocIdx)
    while acc < target and (lo > pMin or hi < pMax)
        float vUp = hi < pMax ? array.get(profVol, hi + 1) : -1.0
        float vDn = lo > pMin ? array.get(profVol, lo - 1) : -1.0
        if vUp >= vDn
            hi += 1
            acc += vUp
        else
            lo -= 1
            acc += vDn
    poc  := profBase + (pocIdx - PROF_OFF) * binSize
    vaHi := profBase + (hi - PROF_OFF) * binSize + binSize / 2
    vaLo := profBase + (lo - PROF_OFF) * binSize - binSize / 2

// ═════════════════════════ VWAP (trading-day anchor) ═════════════════════════
var float pv  = 0.0
var float vv  = 0.0
var float pv2 = 0.0
tp = hlc3
if newDay
    pv := 0.0
    vv := 0.0
    pv2 := 0.0
pv += tp * volume
vv += volume
pv2 += tp * tp * volume
vwap = vv > 0 ? pv / vv : na
vsd  = vv > 0 ? math.sqrt(math.max(pv2 / vv - vwap * vwap, 0.0)) : na
vwapSlope = atr > 0 and not na(vwap) ? f_clamp((vwap - nz(vwap[10], vwap)) / atr) : 0.0
vwapLine = newDay ? na : vwap
up1 = newDay or na(vsd) ? na : vwap + vsd
dn1 = newDay or na(vsd) ? na : vwap - vsd
up2 = newDay or na(vsd) ? na : vwap + 2 * vsd
dn2 = newDay or na(vsd) ? na : vwap - 2 * vsd

// ═════════════════════════ Swings, structure, divergence ═════════════════════════
ph = ta.pivothigh(high, swingN, swingN)
pl = ta.pivotlow(low, swingN, swingN)
var float sh1 = na
var float sh2 = na
var float shC1 = na
var float shC2 = na
var float sl1 = na
var float sl2 = na
var float slC1 = na
var float slC2 = na
var hiP = array.new_float()
var hiI = array.new_int()
var loP = array.new_float()
var loI = array.new_int()
var int lastDivIdx = na
var int lastDivDir = 0
divMark = 0
if not na(ph)
    sh2 := sh1
    shC2 := shC1
    sh1 := ph
    shC1 := cvd[swingN]
    array.unshift(hiP, ph)
    array.unshift(hiI, bar_index - swingN)
    if array.size(hiP) > 10
        array.pop(hiP)
        array.pop(hiI)
    if not na(sh2) and sh1 > sh2 and shC1 <= shC2
        divMark := -1
        lastDivIdx := bar_index
        lastDivDir := -1
if not na(pl)
    sl2 := sl1
    slC2 := slC1
    sl1 := pl
    slC1 := cvd[swingN]
    array.unshift(loP, pl)
    array.unshift(loI, bar_index - swingN)
    if array.size(loP) > 10
        array.pop(loP)
        array.pop(loI)
    if not na(sl2) and sl1 < sl2 and slC1 >= slC2
        divMark := 1
        lastDivIdx := bar_index
        lastDivDir := 1
structure = (not na(sh2) and not na(sl2) and sh1 > sh2 and sl1 > sl2) ? 1 : (not na(sh2) and not na(sl2) and sh1 < sh2 and sl1 < sl2) ? -1 : 0

// ═════════════════════════ Absorption / exhaustion / trapped traders ═════════════════════════
rng = high - low
absorbBuy  = volZ >= absZ and deltaPct <= -0.10 and rng > 0 and (close - low) >= 0.4 * rng and low <= low[1]
absorbSell = volZ >= absZ and deltaPct >= 0.10 and rng > 0 and (high - close) >= 0.4 * rng and high >= high[1]
absMark = absorbBuy ? 1 : absorbSell ? -1 : 0
upRun = close > close[3] and high >= high[1] and high[1] >= high[2]
dnRun = close < close[3] and low <= low[1] and low[1] <= low[2]
exhTop = upRun and volZ <= -0.3 and rng > 0 and (high - close) >= 0.5 * rng
exhBot = dnRun and volZ <= -0.3 and rng > 0 and (close - low) >= 0.5 * rng
exhMark = exhTop ? -1 : exhBot ? 1 : 0
var int lastAbsIdx = na
var int lastAbsDir = 0
var int lastExhIdx = na
var int lastExhDir = 0
if absMark != 0
    lastAbsIdx := bar_index
    lastAbsDir := absMark
if exhMark != 0
    lastExhIdx := bar_index
    lastExhDir := exhMark
// a breakout with strong delta through a key level that fails within three bars = trapped traders
f_crossUp(L) => not na(L) and close > L and close[1] <= L
f_crossDn(L) => not na(L) and close < L and close[1] >= L
var float brkUpLvl = na
var int   brkUpIdx = na
var float brkDnLvl = na
var int   brkDnIdx = na
var int   lastTrapIdx = na
var int   lastTrapDir = 0
trapMark = 0
if deltaPct >= 0.2 and (f_crossUp(pdh) or f_crossUp(ibHigh) or f_crossUp(onH) or f_crossUp(sh1) or f_crossUp(pwH) or f_crossUp(vaHi))
    brkUpLvl := f_crossUp(pdh) ? pdh : f_crossUp(ibHigh) ? ibHigh : f_crossUp(onH) ? onH : f_crossUp(sh1) ? sh1 : f_crossUp(pwH) ? pwH : vaHi
    brkUpIdx := bar_index
if deltaPct <= -0.2 and (f_crossDn(pdl) or f_crossDn(ibLow) or f_crossDn(onL) or f_crossDn(sl1) or f_crossDn(pwL) or f_crossDn(vaLo))
    brkDnLvl := f_crossDn(pdl) ? pdl : f_crossDn(ibLow) ? ibLow : f_crossDn(onL) ? onL : f_crossDn(sl1) ? sl1 : f_crossDn(pwL) ? pwL : vaLo
    brkDnIdx := bar_index
if not na(brkUpIdx) and bar_index - brkUpIdx >= 1 and bar_index - brkUpIdx <= 3 and close < brkUpLvl
    trapMark := -1
    lastTrapIdx := bar_index
    lastTrapDir := -1
    brkUpIdx := na
if not na(brkDnIdx) and bar_index - brkDnIdx >= 1 and bar_index - brkDnIdx <= 3 and close > brkDnLvl
    trapMark := 1
    lastTrapIdx := bar_index
    lastTrapDir := 1
    brkDnIdx := na
f_decay(idx, dir) => na(idx) ? 0.0 : dir * math.exp(-(bar_index - idx) / 8.0)

// ═════════════════════════ Regime, MTF, ribbon ═════════════════════════
erDen = math.sum(math.abs(ta.change(close)), 20)
er = erDen > 0 ? math.abs(close - close[20]) / erDen : 0.0
atrRatio = ta.atr(50) > 0 ? ta.atr(7) / ta.atr(50) : 1.0
outsideValue = not na(pdh) and (close > pdh or close < pdl) ? 1.0 : 0.0
trendiness = 0.35 * math.min(er / 0.35, 1.0) + 0.25 * math.abs(vwapSlope) + 0.2 * math.abs(structure) + 0.2 * outsideValue
direction = 0.4 * vwapSlope + 0.3 * structure + 0.2 * (not na(vwap) and close > vwap ? 1.0 : -1.0) + 0.1 * (not na(pdh) and close > (pdh + pdl) / 2 ? 1.0 : -1.0)
candReg = (atrRatio >= 1.3 and er < 0.2) ? 4 : trendiness >= 0.45 ? (direction > 0 ? 1 : 2) : 3
var int regime = 0
var int regCand = 0
var int regBars = 0
if candReg == regCand
    regBars += 1
else
    regCand := candReg
    regBars := 1
if regBars >= 3
    regime := candReg
regName = regime == 1 ? "TREND UP" : regime == 2 ? "TREND DOWN" : regime == 3 ? "BALANCE" : regime == 4 ? "VOLATILE CHOP" : "WARMING UP"
f_tfBias() =>
    e = ta.ema(close, 20)
    (close > e ? 0.5 : -0.5) + (e > e[3] ? 0.5 : e < e[3] ? -0.5 : 0.0)
mChart = f_tfBias()
m5raw  = request.security(syminfo.tickerid, "5",  f_tfBias()[1], lookahead=barmerge.lookahead_on)
m15raw = request.security(syminfo.tickerid, "15", f_tfBias()[1], lookahead=barmerge.lookahead_on)
m60raw = request.security(syminfo.tickerid, "60", f_tfBias()[1], lookahead=barmerge.lookahead_on)
m5  = timeframe.in_seconds() < 300  ? m5raw  : mChart
m15 = timeframe.in_seconds() < 900  ? m15raw : mChart
m60 = timeframe.in_seconds() < 3600 ? m60raw : mChart
mtfBias = 0.25 * mChart + 0.3 * nz(m5) + 0.25 * nz(m15) + 0.2 * nz(m60)
emaF = ta.ema(close, 9)
emaS = ta.ema(close, 21)
ribbonUp = emaF > emaS

// ═════════════════════════ Reference feeds: ES relative strength, NYSE TICK ═════════════════════════
esRaw   = request.security(esSym, timeframe.period, close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
esClose = useFeeds ? esRaw : na
rsRaw   = not na(esClose) and nz(close[20], 0) > 0 and nz(esClose[20], 0) > 0 ? (close / close[20] - 1) - (esClose / esClose[20] - 1) : na
rsSd    = ta.stdev(rsRaw, 100)
rsZ     = not na(rsRaw) and rsSd > 0 ? (rsRaw - ta.sma(rsRaw, 100)) / rsSd : na
tickRaw = request.security(tickSym, timeframe.period, close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
tickVal = useFeeds ? tickRaw : na
var float tickCum = 0.0
var int   tickN = 0
if rthOpen
    tickCum := 0.0
    tickN := 0
if inRTH and not na(tickVal)
    tickCum += tickVal
    tickN += 1
tickAvg = tickN > 0 ? tickCum / tickN : na

// ═════════════════════════ Features → Directional Conviction Score ═════════════════════════
fVwapPos   = not na(vsd) and vsd > 0 ? f_clamp((close - vwap) / (2 * vsd)) : 0.0
fVwapSlope = vwapSlope
fStruct    = structure * 1.0
fMtf       = mtfBias
fRegime    = regime == 1 ? trendiness : regime == 2 ? -trendiness : 0.0
fDelta     = f_clamp(deltaPct / 0.3)
fCvd       = f_clamp(cvdZ / 2)
fAbs       = f_decay(lastAbsIdx, lastAbsDir)
fTrap      = f_decay(lastTrapIdx, lastTrapDir)
fDiv       = f_decay(lastDivIdx, lastDivDir)
fExh       = f_decay(lastExhIdx, lastExhDir)
fValue     = not na(pdh) and pdh > pdl ? f_clamp((close - (pdh + pdl) / 2) / ((pdh - pdl) / 2)) : 0.0
fRs        = na(rsZ) ? na : f_clamp(rsZ / 2)
fTick      = na(tickAvg) ? na : f_clamp(tickAvg / 400)
isTrend = regime == 1 or regime == 2
isBal   = regime == 3
isChop  = regime == 4
gT  = isChop ? 0.5 : isBal ? 0.6 : 1.0
gFl = isChop ? 0.5 : 1.0
gRv = isChop ? 0.5 : isTrend ? 0.5 : 1.0
gLo = isChop ? 0.5 : isTrend ? 0.5 : isBal ? -1.0 : 1.0
gIn = isChop ? 0.5 : 1.0
feats = array.from(fVwapPos, fVwapSlope, fStruct, fMtf, fRegime, fDelta, fCvd, fAbs, fTrap, fDiv, fExh, fValue, fRs, fTick)
ws    = array.from(1.0, 1.2, 1.5, 1.5, 1.0, 1.0, 1.5, 1.2, 1.2, 1.0, 0.8, 0.6, 0.8, 0.8)
gs    = array.from(gT, gT, gT, gT, gT, gFl, gFl, gRv, gRv, gRv, gRv, gLo, gIn, gIn)
float num = 0.0
float den = 0.0
for k = 0 to 13
    f = array.get(feats, k)
    if not na(f)
        wk = array.get(ws, k) * array.get(gs, k)
        num += wk * f
        den += math.abs(wk)
dcs = den > 0 ? math.max(-100.0, math.min(100.0, 100.0 * num / den)) : 0.0
bias = dcs >= sigThr ? 1 : dcs <= -sigThr ? -1 : 0
dcsTrend = dcs - nz(dcs[5], dcs)

// ═════════════════════════ Level list (stops, targets, tags) ═════════════════════════
// kinds: 1 PDH 2 PDL 3 PDC 4 ONH 5 ONL 6 IBH 7 IBL 8 PWH 9 PWL 10 VWAP 11 VWAP+1 12 VWAP-1 13 VWAP+2 14 VWAP-2
//        15 swing H 16 swing L 17 POC 18 VAH 19 VAL 20 pdPOC 21 pdVAH 22 pdVAL
lvP = array.new_float()
lvK = array.new_int()
f_add(p, k) =>
    if not na(p)
        array.push(lvP, p)
        array.push(lvK, k)
f_add(pdh, 1)
f_add(pdl, 2)
f_add(pdc, 3)
f_add(onH, 4)
f_add(onL, 5)
f_add(ibHigh, 6)
f_add(ibLow, 7)
f_add(pwH, 8)
f_add(pwL, 9)
f_add(vwap, 10)
f_add(not na(vsd) ? vwap + vsd : na, 11)
f_add(not na(vsd) ? vwap - vsd : na, 12)
f_add(not na(vsd) ? vwap + 2 * vsd : na, 13)
f_add(not na(vsd) ? vwap - 2 * vsd : na, 14)
f_add(sh1, 15)
f_add(sl1, 16)
f_add(poc, 17)
f_add(vaHi, 18)
f_add(vaLo, 19)
f_add(pdPoc, 20)
f_add(pdVah, 21)
f_add(pdVal, 22)
f_name(k) => k == 1 ? "PDH" : k == 2 ? "PDL" : k == 3 ? "PDC" : k == 4 ? "ONH" : k == 5 ? "ONL" : k == 6 ? "IBH" : k == 7 ? "IBL" : k == 8 ? "PWH" : k == 9 ? "PWL" : k == 10 ? "VWAP" : k == 11 ? "VWAP+1" : k == 12 ? "VWAP-1" : k == 13 ? "VWAP+2" : k == 14 ? "VWAP-2" : k == 15 ? "SWING H" : k == 16 ? "SWING L" : k == 17 ? "POC" : k == 18 ? "VAH" : k == 19 ? "VAL" : k == 20 ? "pdPOC" : k == 21 ? "pdVAH" : k == 22 ? "pdVAL" : "LVL"
f_famCol(k) => (k == 1 or k == 2 or k == 3) ? cPD : (k == 4 or k == 5) ? cON : (k == 6 or k == 7) ? cIB : (k == 8 or k == 9) ? cPW : (k >= 17 and k <= 22) ? cGold : cLevel
f_strong(k) => k == 1 or k == 2 or k == 4 or k == 5 or k == 6 or k == 7 or k == 8 or k == 9 or k == 10 or (k >= 17 and k <= 22)
// nearest level of the given kinds within tol of price
f_near(price, tol, kinds) =>
    float bestP = na
    int bestK = 0
    float bestD = 1e18
    if array.size(lvP) > 0
        for i = 0 to array.size(lvP) - 1
            k = array.get(lvK, i)
            if array.includes(kinds, k)
                d = math.abs(array.get(lvP, i) - price)
                if d <= tol and d < bestD
                    bestD := d
                    bestP := array.get(lvP, i)
                    bestK := k
    [not na(bestP), bestP, bestK]
// next two levels in the trade direction at least minDist away
f_targets(dir, entry, minDist) =>
    float t1 = na
    float t2 = na
    int k1 = 0
    float d1 = 1e18
    float d2 = 1e18
    if array.size(lvP) > 0
        for i = 0 to array.size(lvP) - 1
            d = dir > 0 ? array.get(lvP, i) - entry : entry - array.get(lvP, i)
            if d >= minDist
                if d < d1
                    d2 := d1
                    t2 := t1
                    d1 := d
                    t1 := array.get(lvP, i)
                    k1 := array.get(lvK, i)
                else if d < d2 and d > d1
                    d2 := d
                    t2 := array.get(lvP, i)
    if not na(t1) and na(t2)
        t2 := entry + (t1 - entry) * 2.0
    [t1, t2, k1]

// ═════════════════════════ Setups (closed bars, one per bar) ═════════════════════════
tol = levelTol * atr
buf = stopBuf * atr
deltaFlipUp = deltaPct >= 0.15 and deltaPct[1] < 0
deltaFlipDn = deltaPct <= -0.15 and deltaPct[1] > 0
flowUp = cvdZ > 0.5 or deltaPct >= 0.2
flowDn = cvdZ < -0.5 or deltaPct <= -0.2
ribOkL = not useRibbon or ribbonUp
ribOkS = not useRibbon or not ribbonUp
canEval = barstate.isconfirmed and (not rthOnly or inRTH) and inWindow and regime != 0 and atr > 0
int   cType = 0
int   cDir = 0
float cStop = na
int   cRefK = 0
int   cPri = -1
float cTrig = 0.0
// 1. trend pullback to VWAP / bands / POC / swing (priority 3)
if canEval and regime == 1 and dcs >= sigThr and ribOkL and (not useMtf or mtfBias > 0.1)
    [f, lp, lk] = f_near(low, tol, array.from(10, 12, 11, 16, 17))
    if f and close > lp and (absMark == 1 or deltaFlipUp)
        cType := 1
        cDir := 1
        cStop := math.min(low, lp) - buf
        cRefK := lk
        cPri := 3
        cTrig := (absMark == 1 ? 1.0 : 0.0) + (deltaFlipUp ? 0.5 : 0.0)
if canEval and regime == 2 and dcs <= -sigThr and ribOkS and (not useMtf or mtfBias < -0.1)
    [f, lp, lk] = f_near(high, tol, array.from(10, 11, 12, 15, 17))
    if f and close < lp and (absMark == -1 or deltaFlipDn)
        cType := 1
        cDir := -1
        cStop := math.max(high, lp) + buf
        cRefK := lk
        cPri := 3
        cTrig := (absMark == -1 ? 1.0 : 0.0) + (deltaFlipDn ? 0.5 : 0.0)
// 2. value-edge fade in balance (priority 2)
if canEval and regime == 3 and cPri < 2
    [fh, hp, hk] = f_near(high, tol, array.from(18, 21, 1, 6, 4, 13, 8))
    if dcs <= -sigThr * 0.4 and fh and close < hp and (absMark == -1 or exhMark == -1 or trapMark == -1 or (deltaPct <= -0.15 and high >= hp))
        cType := 2
        cDir := -1
        cStop := math.max(high, hp) + buf
        cRefK := hk
        cPri := 2
        cTrig := (absMark == -1 ? 1.0 : 0.0) + (exhMark == -1 ? 0.75 : 0.0) + (trapMark == -1 ? 1.0 : 0.0) + (deltaPct <= -0.15 ? 0.5 : 0.0)
    [fl, lp, lk] = f_near(low, tol, array.from(19, 22, 2, 7, 5, 14, 9))
    if cPri < 2 and dcs >= sigThr * 0.4 and fl and close > lp and (absMark == 1 or exhMark == 1 or trapMark == 1 or (deltaPct >= 0.15 and low <= lp))
        cType := 2
        cDir := 1
        cStop := math.min(low, lp) - buf
        cRefK := lk
        cPri := 2
        cTrig := (absMark == 1 ? 1.0 : 0.0) + (exhMark == 1 ? 0.75 : 0.0) + (trapMark == 1 ? 1.0 : 0.0) + (deltaPct >= 0.15 ? 0.5 : 0.0)
// 3. failed breakout / trapped traders (priority 4)
if canEval and trapMark != 0
    ext = trapMark < 0 ? math.max(high, high[1], high[2], high[3]) : math.min(low, low[1], low[2], low[3])
    [f, lp, lk] = f_near(ext, tol * 1.5, trapMark < 0 ? array.from(6, 1, 4, 15, 8, 18, 21) : array.from(7, 2, 5, 16, 9, 19, 22))
    if f and (trapMark < 0 ? dcs < sigThr : dcs > -sigThr)
        cType := 3
        cDir := trapMark
        cStop := trapMark < 0 ? ext + buf : ext - buf
        cRefK := lk
        cPri := 4
        cTrig := 1.0 + (absMark == trapMark ? 0.5 : 0.0) + (trapMark < 0 ? (deltaPct <= -0.15 ? 0.5 : 0.0) : (deltaPct >= 0.15 ? 0.5 : 0.0))
// 4. break-and-acceptance (priority 2)
if canEval and cPri < 2 and regime != 4 and array.size(lvP) > 0
    for i = 0 to array.size(lvP) - 1
        L = array.get(lvP, i)
        k = array.get(lvK, i)
        hi = k == 6 or k == 1 or k == 4 or k == 8 or k == 18 or k == 21
        lo = k == 7 or k == 2 or k == 5 or k == 9 or k == 19 or k == 22
        if hi and ribOkL and dcs >= sigThr and deltaPct > 0 and flowUp and close > L and close[1] > L and close[2] <= L and close - L <= 2 * atr
            cType := 4
            cDir := 1
            cStop := L - buf
            cRefK := k
            cPri := 2
            cTrig := (deltaPct >= 0.2 ? 1.0 : 0.5) + (cvdZ > 1 ? 0.5 : 0.0)
            break
        if lo and ribOkS and dcs <= -sigThr and deltaPct < 0 and flowDn and close < L and close[1] < L and close[2] >= L and L - close <= 2 * atr
            cType := 4
            cDir := -1
            cStop := L + buf
            cRefK := k
            cPri := 2
            cTrig := (deltaPct <= -0.2 ? 1.0 : 0.5) + (cvdZ < -1 ? 0.5 : 0.0)
            break
// 5. CVD divergence at a liquidity level (priority 3)
if canEval and divMark != 0 and cPri < 3
    pivot = divMark > 0 ? sl1 : sh1
    [f, lp, lk] = f_near(pivot, tol * 1.5, divMark > 0 ? array.from(2, 5, 7, 9, 14, 16, 19, 22) : array.from(1, 4, 6, 8, 13, 15, 18, 21))
    if f and (divMark > 0 ? dcs > -sigThr : dcs < sigThr)
        cType := 5
        cDir := divMark
        cStop := divMark > 0 ? pivot - buf : pivot + buf
        cRefK := lk
        cPri := 3
        cTrig := 1.0 + (absMark == divMark ? 0.5 : 0.0)

// ═════════════════════════ Trade plan, grade, expectancy gate ═════════════════════════
var statW = array.new_int(6, 0)
var statL = array.new_int(6, 0)
var statR = array.new_float(6, 0.0)
var int   shW = 0
var int   shL = 0
var float shR = 0.0
var int   lastSigIdx = na
var int   lastSigType = 0
var int   lastSigDir = 0
int   sigDir = 0
int   sigType = 0
bool  sigShown = false
float sigEntry = na
float sigStop = na
float sigT1 = na
float sigT2 = na
float sigRR = na
int   sigGrade = 3
int   sigSize = 0
if cType != 0
    entry = close
    stop = cStop
    minRisk = math.max(minStop * atr, 6 * syminfo.mintick)
    if cDir > 0 and entry - stop < minRisk
        stop := entry - minRisk
    if cDir < 0 and stop - entry < minRisk
        stop := entry + minRisk
    risk = math.abs(entry - stop)
    okStop = (cDir > 0 ? stop < entry : stop > entry) and risk <= maxStop * atr
    if okStop
        [t1, t2, k1] = f_targets(cDir, entry, math.max(0.5 * atr, risk * minRR))
        if not na(t1)
            rr = math.abs(t1 - entry) / risk
            if rr >= minRR
                ad = math.abs(dcs)
                score = (ad >= sigThr ? 1.0 : ad >= sigThr / 2 ? 0.5 : 0.0) + (f_strong(cRefK) ? 1.0 : 0.5) + math.min(1.5, cTrig)
                score += mtfBias * cDir > 0.1 ? 1.0 : mtfBias * cDir < -0.1 ? -0.5 : 0.25
                score += cType == 1 ? (isTrend ? 1.0 : 0.25) : cType == 2 ? (isBal ? 1.0 : 0.25) : cType == 3 ? 0.75 : cType == 4 ? (isTrend ? 1.0 : 0.6) : (isBal ? 1.0 : 0.5)
                grade = score >= 4.0 ? 1 : score >= 3.0 ? 2 : 3
                dup = not na(lastSigIdx) and bar_index - lastSigIdx <= 3 and lastSigType == cType and lastSigDir == cDir
                if not dup and grade <= 2
                    nT = array.get(statW, cType) + array.get(statL, cType)
                    avgT = nT > 0 ? array.get(statR, cType) / nT : 0.0
                    mutedT = gateOn and nT >= gateN and avgT < gateR
                    sigDir := cDir
                    sigType := cType
                    sigEntry := entry
                    sigStop := stop
                    sigT1 := t1
                    sigT2 := t2
                    sigRR := rr
                    sigGrade := grade
                    sigSize := riskUSD > 0 and pointVal > 0 ? math.floor(riskUSD / (risk * pointVal)) : 0
                    sigShown := not mutedT and (grade == 1 or showB) and (maxTrades == 0 or tradesToday < maxTrades)
                    lastSigIdx := bar_index
                    lastSigType := cType
                    lastSigDir := cDir
                    if sigShown
                        tradesToday += 1

// ═════════════════════════ Forward validation (stop first, then T1, timeout 120 bars) ═════════════════════════
// Every A/B signal is tracked, shown or muted, so the gate always sees each setup's real record.
var trEntry = array.new_float()
var trStop  = array.new_float()
var trT1    = array.new_float()
var trT2    = array.new_float()
var trDir   = array.new_int()
var trIdx   = array.new_int()
var trType  = array.new_int()
var trShown = array.new_bool()
if barstate.isconfirmed and array.size(trEntry) > 0
    for i = array.size(trEntry) - 1 to 0
        e = array.get(trEntry, i)
        s = array.get(trStop, i)
        t = array.get(trT1, i)
        d = array.get(trDir, i)
        ty = array.get(trType, i)
        age = bar_index - array.get(trIdx, i)
        rk = math.abs(e - s)
        float res = na
        float exitPx = na
        string why = ""
        if d > 0
            if low <= s
                res := -1.0
                exitPx := s
                why := "stop"
            else if high >= t
                res := math.abs(t - e) / rk
                exitPx := t
                why := "T1"
        else
            if high >= s
                res := -1.0
                exitPx := s
                why := "stop"
            else if low <= t
                res := math.abs(t - e) / rk
                exitPx := t
                why := "T1"
        if na(res) and age >= 120
            res := d * (close - e) / rk
            exitPx := close
            why := "timeout"
        if not na(res)
            if res > 0
                array.set(statW, ty, array.get(statW, ty) + 1)
            else
                array.set(statL, ty, array.get(statL, ty) + 1)
            array.set(statR, ty, array.get(statR, ty) + res)
            if array.get(trShown, i)
                if res > 0
                    shW += 1
                else
                    shL += 1
                shR += res
                if showOutcomes
                    label.new(bar_index, exitPx, f_signed(res, "0.0") + "R", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(res > 0 ? cBull : cBear, 82), style=label.style_label_left, textcolor=res > 0 ? cBull : cBear, size=size.tiny, tooltip=f_setupName(ty) + ": " + why + " at " + f_px(exitPx), text_font_family=font.family_monospace)
            array.remove(trEntry, i)
            array.remove(trStop, i)
            array.remove(trT1, i)
            array.remove(trT2, i)
            array.remove(trDir, i)
            array.remove(trIdx, i)
            array.remove(trType, i)
            array.remove(trShown, i)
if sigDir != 0
    array.push(trEntry, sigEntry)
    array.push(trStop, sigStop)
    array.push(trT1, sigT1)
    array.push(trT2, sigT2)
    array.push(trDir, sigDir)
    array.push(trIdx, bar_index)
    array.push(trType, sigType)
    array.push(trShown, sigShown)
    if sigShown and showSig
        gTxt = sigGrade == 1 ? "A" : "B"
        tip = (sigDir > 0 ? "LONG " : "SHORT ") + gTxt + " · " + f_setupName(sigType) + "\nEntry " + f_px(sigEntry) + "\nStop  " + f_px(sigStop) + "\nT1    " + f_px(sigT1) + "  (R:R " + str.tostring(sigRR, "0.0") + ")\nT2    " + f_px(sigT2) + (sigSize > 0 ? "\nSize  " + str.tostring(sigSize) + "x" : "")
        label.new(bar_index, close, gTxt, xloc=xloc.bar_index, yloc=sigDir > 0 ? yloc.belowbar : yloc.abovebar, color=sigDir > 0 ? cBull : cBear, style=sigDir > 0 ? label.style_label_up : label.style_label_down, textcolor=cPanel, size=size.small, tooltip=tip)

// live trade = the newest open signal that was shown
openN = array.size(trEntry)
int liveI = -1
if openN > 0
    for i = openN - 1 to 0
        if liveI < 0 and array.get(trShown, i)
            liveI := i
float lvEntry = na
float lvStop = na
float lvT1 = na
float lvT2 = na
int   lvDir = 0
int   lvIdx = na
int   lvType = 0
float lvR = na
if liveI >= 0
    lvEntry := array.get(trEntry, liveI)
    lvStop := array.get(trStop, liveI)
    lvT1 := array.get(trT1, liveI)
    lvT2 := array.get(trT2, liveI)
    lvDir := array.get(trDir, liveI)
    lvIdx := array.get(trIdx, liveI)
    lvType := array.get(trType, liveI)
    lvR := lvDir * (close - lvEntry) / math.abs(lvEntry - lvStop)
liveAge = liveI >= 0 ? bar_index - lvIdx : 9999

// ═════════════════════════ Visuals: candles, ribbon, VWAP glow + cloud, marks ═════════════════════════
candleCol = math.abs(dcs) < weakThr ? (close >= open ? cNeuUp : cNeuDn) : dcs > 0 ? color.from_gradient(dcs, weakThr, 80, color.new(cBull, 45), cBull) : color.from_gradient(dcs, -80, -weakThr, cBear, color.new(cBear, 45))
barcolor(candleCol, title="Conviction candles")
plot(dcs, "DCS", color=cVwap, display=display.data_window)   // source for the NQ Edge Flow pane (DCS mode)
bgcolor(showWin and inWindow and (not rthOnly or inRTH) ? color.new(cVwap, 96) : na, title="Trade window")
ribCol = ribbonUp ? cBull : cBear
pF = plot(showRibbon ? emaF : na, "EMA 9", color.new(ribCol, 45), 1, display=display.pane)
pS = plot(showRibbon ? emaS : na, "EMA 21", color.new(ribCol, 65), 1, display=display.pane)
fill(pF, pS, color=color.new(ribCol, 84), title="EMA ribbon")
plot(vwapLine, "VWAP glow outer", color.new(cVwap, 88), 8, plot.style_linebr, display=display.pane)
plot(vwapLine, "VWAP glow inner", color.new(cVwap, 72), 4, plot.style_linebr, display=display.pane)
pV  = plot(vwapLine, "VWAP", cVwap, 2, plot.style_linebr, display=display.all - display.status_line)
pU1 = plot(showBand ? up1 : na, "VWAP +1σ", color.new(cBand, 55), 1, plot.style_linebr, display=display.pane)
pL1 = plot(showBand ? dn1 : na, "VWAP -1σ", color.new(cBand, 55), 1, plot.style_linebr, display=display.pane)
fill(pU1, pV, showBand ? up1 : na, showBand ? vwapLine : na, color.new(cBand, 84), color.new(cVwap, 97), "VWAP upper cloud")
fill(pV, pL1, showBand ? vwapLine : na, showBand ? dn1 : na, color.new(cVwap, 97), color.new(cBand, 84), "VWAP lower cloud")
plot(showBand2 ? up2 : na, "VWAP +2σ", color.new(cBand, 70), 1, plot.style_linebr, display=display.pane)
plot(showBand2 ? dn2 : na, "VWAP -2σ", color.new(cBand, 70), 1, plot.style_linebr, display=display.pane)
// absorption bubbles at the absorbed price, a soft glow ring around a solid core, sized by volume z
bubBuyY  = showBub and absorbBuy ? low : na
bubSellY = showBub and absorbSell ? high : na
plotshape(volZ < 3 ? bubBuyY : na, "Absorption buy glow S", shape.circle, location.absolute, color.new(cBull, 78), size=size.small, display=display.pane)
plotshape(volZ < 3 ? bubBuyY : na, "Absorption buy S", shape.circle, location.absolute, color.new(cBull, 5), size=size.tiny, display=display.pane)
plotshape(volZ >= 3 and volZ < 4 ? bubBuyY : na, "Absorption buy glow M", shape.circle, location.absolute, color.new(cBull, 78), size=size.normal, display=display.pane)
plotshape(volZ >= 3 and volZ < 4 ? bubBuyY : na, "Absorption buy M", shape.circle, location.absolute, color.new(cBull, 5), size=size.small, display=display.pane)
plotshape(volZ >= 4 ? bubBuyY : na, "Absorption buy glow L", shape.circle, location.absolute, color.new(cBull, 78), size=size.large, display=display.pane)
plotshape(volZ >= 4 ? bubBuyY : na, "Absorption buy L", shape.circle, location.absolute, color.new(cBull, 5), size=size.normal, display=display.pane)
plotshape(volZ < 3 ? bubSellY : na, "Absorption sell glow S", shape.circle, location.absolute, color.new(cBear, 78), size=size.small, display=display.pane)
plotshape(volZ < 3 ? bubSellY : na, "Absorption sell S", shape.circle, location.absolute, color.new(cBear, 5), size=size.tiny, display=display.pane)
plotshape(volZ >= 3 and volZ < 4 ? bubSellY : na, "Absorption sell glow M", shape.circle, location.absolute, color.new(cBear, 78), size=size.normal, display=display.pane)
plotshape(volZ >= 3 and volZ < 4 ? bubSellY : na, "Absorption sell M", shape.circle, location.absolute, color.new(cBear, 5), size=size.small, display=display.pane)
plotshape(volZ >= 4 ? bubSellY : na, "Absorption sell glow L", shape.circle, location.absolute, color.new(cBear, 78), size=size.large, display=display.pane)
plotshape(volZ >= 4 ? bubSellY : na, "Absorption sell L", shape.circle, location.absolute, color.new(cBear, 5), size=size.normal, display=display.pane)
plotshape(marksAll and exhTop, "Exhaustion top", shape.triangledown, location.abovebar, color.new(cGold, 40), size=size.tiny, display=display.pane)
plotshape(marksAll and exhBot, "Exhaustion bottom", shape.triangleup, location.belowbar, color.new(cGold, 40), size=size.tiny, display=display.pane)
plotshape(marksKey and trapMark < 0, "Trapped longs", shape.xcross, location.abovebar, color.new(cBear, 30), size=size.tiny, display=display.pane)
plotshape(marksKey and trapMark > 0, "Trapped shorts", shape.xcross, location.belowbar, color.new(cBull, 30), size=size.tiny, display=display.pane)
plotshape(marksKey and divMark < 0, "CVD divergence (bearish)", shape.diamond, location.abovebar, color.new(cMag, 20), size=size.tiny, display=display.pane)
plotshape(marksKey and divMark > 0, "CVD divergence (bullish)", shape.diamond, location.belowbar, color.new(cMag, 20), size=size.tiny, display=display.pane)

// ═════════════════════════ Last bar: levels, trend lines, profile, live position, dashboard ═════════════════════════
var lvLines   = array.new_line()
var lvLabels  = array.new_label()
var tlLines   = array.new_line()
var profBoxes = array.new_box()
var posBoxes  = array.new_box()
var posLines  = array.new_line()
var posLabels = array.new_label()
var tbl  = table.new(f_pos(hudPos), 2, 10, bgcolor=color.new(cPanel, 6), frame_color=color.new(cVwap, 60), frame_width=1, border_color=cClear, border_width=3)
var perf = table.new(hudPos == "Bottom right" ? position.bottom_left : position.bottom_right, 5, 7, bgcolor=color.new(cPanel, 6), frame_color=color.new(cBand, 55), frame_width=1, border_color=cClear, border_width=3)
// trend line through two swings (newest-first arrays): returns [ok, i1, p1, i2, p2, broken]
f_trendLine(pArr, iArr, highs) =>
    bool ok = false
    int i1 = na
    float p1 = na
    int i2 = na
    float p2 = na
    bool broken = false
    tl = 0.1 * atr
    if array.size(pArr) >= 2
        i2 := array.get(iArr, 0)
        p2 := array.get(pArr, 0)
        for q = 1 to array.size(pArr) - 1
            if not ok
                ci = array.get(iArr, q)
                cp = array.get(pArr, q)
                if i2 - ci >= 3 and bar_index - ci < 1800
                    slope = (p2 - cp) / (i2 - ci)
                    good = true
                    for b = ci + 1 to i2 - 1
                        lv = cp + slope * (b - ci)
                        off = bar_index - b
                        if highs ? high[off] > lv + tl : low[off] < lv - tl
                            good := false
                    if good
                        ok := true
                        i1 := ci
                        p1 := cp
                        if i2 + 1 <= bar_index
                            for b = i2 + 1 to bar_index
                                lv = p2 + slope * (b - i2)
                                off = bar_index - b
                                if highs ? close[off] > lv + tl : close[off] < lv - tl
                                    broken := true
    [ok, i1, p1, i2, p2, broken]

if barstate.islast
    // ---- clear last update's drawings ----
    if array.size(lvLines) > 0
        for i = 0 to array.size(lvLines) - 1
            line.delete(array.get(lvLines, i))
    if array.size(lvLabels) > 0
        for i = 0 to array.size(lvLabels) - 1
            label.delete(array.get(lvLabels, i))
    if array.size(tlLines) > 0
        for i = 0 to array.size(tlLines) - 1
            line.delete(array.get(tlLines, i))
    if array.size(profBoxes) > 0
        for i = 0 to array.size(profBoxes) - 1
            box.delete(array.get(profBoxes, i))
    if array.size(posBoxes) > 0
        for i = 0 to array.size(posBoxes) - 1
            box.delete(array.get(posBoxes, i))
    if array.size(posLines) > 0
        for i = 0 to array.size(posLines) - 1
            line.delete(array.get(posLines, i))
    if array.size(posLabels) > 0
        for i = 0 to array.size(posLabels) - 1
            label.delete(array.get(posLabels, i))
    array.clear(lvLines)
    array.clear(lvLabels)
    array.clear(tlLines)
    array.clear(profBoxes)
    array.clear(posBoxes)
    array.clear(posLines)
    array.clear(posLabels)

    // ---- live position: risk / reward boxes from the signal bar, entry line, T2 line, tags ----
    showLive = showPosTool and liveI >= 0
    if showLive
        xr = bar_index + 2
        rkL = math.abs(lvEntry - lvStop)
        array.push(posBoxes, box.new(lvIdx, math.max(lvEntry, lvStop), xr, math.min(lvEntry, lvStop), border_color=color.new(cBear, 50), border_width=1, bgcolor=color.new(cBear, 80)))
        array.push(posBoxes, box.new(lvIdx, math.max(lvEntry, lvT1), xr, math.min(lvEntry, lvT1), border_color=color.new(cBull, 50), border_width=1, bgcolor=color.new(cBull, 84)))
        array.push(posLines, line.new(lvIdx, lvEntry, xr, lvEntry, xloc=xloc.bar_index, color=cText, width=1))
        array.push(posLines, line.new(lvIdx, lvT2, xr, lvT2, xloc=xloc.bar_index, color=color.new(cBull, 35), style=line.style_dotted, width=1))
        array.push(posLabels, label.new(xr + 1, lvEntry, "ENTRY " + f_px(lvEntry) + "  " + f_signed(lvR, "0.0") + "R", xloc=xloc.bar_index, yloc=yloc.price, color=cText, style=label.style_label_left, textcolor=cPanel, size=size.tiny, text_font_family=font.family_monospace))
        array.push(posLabels, label.new(xr + 1, lvStop, "STOP " + f_px(lvStop) + "  -1R", xloc=xloc.bar_index, yloc=yloc.price, color=cBear, style=label.style_label_left, textcolor=cPanel, size=size.tiny, text_font_family=font.family_monospace))
        array.push(posLabels, label.new(xr + 1, lvT1, "T1 " + f_px(lvT1) + "  +" + str.tostring(math.abs(lvT1 - lvEntry) / rkL, "0.0") + "R", xloc=xloc.bar_index, yloc=yloc.price, color=cBull, style=label.style_label_left, textcolor=cPanel, size=size.tiny, text_font_family=font.family_monospace))
        array.push(posLabels, label.new(xr + 1, lvT2, "T2 " + f_px(lvT2) + "  +" + str.tostring(math.abs(lvT2 - lvEntry) / rkL, "0.0") + "R", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(cBull, 40), style=label.style_label_left, textcolor=cPanel, size=size.tiny, text_font_family=font.family_monospace))

    // ---- key levels: nearest per side, equal prices merged, VWAP family excluded (plotted) ----
    if showLevels and array.size(lvP) > 0
        dist = array.new_float()
        for i = 0 to array.size(lvP) - 1
            k = array.get(lvK, i)
            pr = array.get(lvP, i)
            skip = (k >= 10 and k <= 14) or (showLive and (math.abs(pr - lvEntry) < 0.15 * atr or math.abs(pr - lvStop) < 0.15 * atr or math.abs(pr - lvT1) < 0.15 * atr or math.abs(pr - lvT2) < 0.15 * atr))
            array.push(dist, skip ? 1e18 : math.abs(pr - close))
        idx = array.sort_indices(dist, order.ascending)
        chP = array.new_float()
        chT = array.new_string()
        chK = array.new_int()
        int nUp = 0
        int nDn = 0
        for j = 0 to array.size(idx) - 1
            ii = array.get(idx, j)
            if array.get(dist, ii) < 1e17
                pr = array.get(lvP, ii)
                k = array.get(lvK, ii)
                int dupAt = -1
                if array.size(chP) > 0
                    for q = 0 to array.size(chP) - 1
                        if math.abs(array.get(chP, q) - pr) < syminfo.mintick * 1.5
                            dupAt := q
                if dupAt >= 0
                    array.set(chT, dupAt, array.get(chT, dupAt) + "/" + f_name(k))
                else if (pr > close and nUp < levelsPer) or (pr <= close and nDn < levelsPer)
                    array.push(chP, pr)
                    array.push(chT, f_name(k))
                    array.push(chK, k)
                    if pr > close
                        nUp += 1
                    else
                        nDn += 1
        if array.size(chP) > 0
            for q = 0 to array.size(chP) - 1
                pr = array.get(chP, q)
                k = array.get(chK, q)
                isNear = math.abs(pr - close) <= tol
                fc = f_famCol(k)
                array.push(lvLines, line.new(bar_index - 60, pr, bar_index + 2, pr, xloc=xloc.bar_index, color=color.new(fc, isNear ? 0 : 50), style=isNear ? line.style_solid : line.style_dotted, width=1))
                array.push(lvLabels, label.new(bar_index + 3, pr, array.get(chT, q) + "  " + f_px(pr), xloc=xloc.bar_index, yloc=yloc.price, color=isNear ? cText : color.new(fc, 12), style=label.style_label_left, textcolor=cPanel, size=size.tiny, text_font_family=font.family_monospace))

    // ---- trend lines with a soft glow ----
    if showTL
        [okH, h1, hp1, h2, hp2, brkH] = f_trendLine(hiP, hiI, true)
        if okH
            slH = (hp2 - hp1) / (h2 - h1)
            yEndH = hp2 + slH * (bar_index + 10 - h2)
            array.push(tlLines, line.new(h1, hp1, bar_index + 10, yEndH, xloc=xloc.bar_index, color=color.new(cBear, 82), width=4))
            array.push(tlLines, line.new(h1, hp1, bar_index + 10, yEndH, xloc=xloc.bar_index, color=cBear, style=brkH ? line.style_dotted : line.style_solid, width=1))
        [okL, l1, lp1, l2, lp2, brkL] = f_trendLine(loP, loI, false)
        if okL
            slL = (lp2 - lp1) / (l2 - l1)
            yEndL = lp2 + slL * (bar_index + 10 - l2)
            array.push(tlLines, line.new(l1, lp1, bar_index + 10, yEndL, xloc=xloc.bar_index, color=color.new(cBull, 82), width=4))
            array.push(tlLines, line.new(l1, lp1, bar_index + 10, yEndL, xloc=xloc.bar_index, color=cBull, style=brkL ? line.style_dotted : line.style_solid, width=1))

    // ---- session volume profile, docked right: value area brighter, POC row gold ----
    if showProf and pMax >= pMin and pocVol > 0
        grp = math.max(1, math.ceil((pMax - pMin + 1) / profRows))
        rowVols = array.new_float()
        float mxRow = 0.0
        for r = pMin to pMax by grp
            float sRow = 0.0
            for b = r to math.min(pMax, r + grp - 1)
                sRow += array.get(profVol, b)
            array.push(rowVols, sRow)
            mxRow := math.max(mxRow, sRow)
        xR = bar_index + profOff + profWidth
        int rowN = 0
        for r = pMin to pMax by grp
            sRow = array.get(rowVols, rowN)
            rowN += 1
            if sRow > 0 and mxRow > 0
                w = math.max(1, math.round(profWidth * sRow / mxRow))
                pTop = profBase + (math.min(pMax, r + grp - 1) - PROF_OFF) * binSize + binSize / 2
                pBot = profBase + (r - PROF_OFF) * binSize - binSize / 2
                inVa = not na(vaLo) and pBot >= vaLo - binSize and pTop <= vaHi + binSize
                isPoc = not na(poc) and poc >= pBot and poc <= pTop
                col = isPoc ? color.new(cGold, 10) : inVa ? color.new(cBand, 40) : color.new(cBand, 75)
                array.push(profBoxes, box.new(xR - w, pTop, xR, pBot, border_color=cClear, border_width=1, bgcolor=col))

    // ---- dashboard ----
    if showHud
        biasTxt = (bias > 0 ? "LONG ▲" : bias < 0 ? "SHORT ▼" : "NEUTRAL") + "   DCS " + f_signed(dcs, "0") + (dcsTrend > 5 ? " ↑" : dcsTrend < -5 ? " ↓" : " →")
        biasBg = bias > 0 ? cBull : bias < 0 ? cBear : color.new(cNeuUp, 0)
        string act = "WAIT"
        string plan = ""
        color actBg = color.new(cNeuUp, 40)
        color actFg = cText
        if liveI >= 0 and liveAge <= 1
            act := (lvDir > 0 ? "BUY NOW " : "SELL NOW ") + f_px(lvEntry)
            plan := "SL " + f_px(lvStop) + " · T1 " + f_px(lvT1) + " · R:R " + str.tostring(math.abs(lvT1 - lvEntry) / math.abs(lvEntry - lvStop), "0.0") + (riskUSD > 0 ? " · " + str.tostring(math.floor(riskUSD / (math.abs(lvEntry - lvStop) * pointVal))) + "x" : "")
            actBg := lvDir > 0 ? cBull : cBear
            actFg := cPanel
        else if liveI >= 0
            act := "IN " + (lvDir > 0 ? "LONG " : "SHORT ") + f_signed(lvR, "0.0") + "R"
            plan := "SL " + f_px(lvStop) + " · T1 " + f_px(lvT1) + (lvR >= 1 ? " · trail stop to entry" : " · half off at T1")
            actBg := color.new(lvDir > 0 ? cBull : cBear, 25)
            actFg := cPanel
        else if not inWindow or (rthOnly and not inRTH)
            act := "NO TRADE"
            plan := "outside the trade window " + winTxt
            actBg := color.new(cBear, 55)
        else if maxTrades > 0 and tradesToday >= maxTrades
            act := "NO TRADE"
            plan := "max signals for today reached"
            actBg := color.new(cBear, 55)
        else if regime == 4
            act := "NO TRADE"
            plan := "volatile chop: stand aside"
            actBg := color.new(cBear, 55)
        else if regime == 1
            plan := "buy a pullback to VWAP " + f_px(vwap) + " on absorption / delta flip"
        else if regime == 2
            plan := "sell a pullback to VWAP " + f_px(vwap) + " on absorption / delta flip"
        else if regime == 3
            plan := "fade VAH / VAL on absorption, target POC"
        else
            plan := "warming up"
        float rPx = na
        int rK = 0
        float sPx = na
        int sK = 0
        if array.size(lvP) > 0
            for i = 0 to array.size(lvP) - 1
                k = array.get(lvK, i)
                pr = array.get(lvP, i)
                if k < 11 or k > 14
                    if pr > close and (na(rPx) or pr < rPx)
                        rPx := pr
                        rK := k
                    if pr <= close and (na(sPx) or pr > sPx)
                        sPx := pr
                        sK := k
        regTxt = regName + " · " + (inRTH ? (ibDone ? "IB done" : "IB forming") : "ETH") + " · ribbon " + (ribbonUp ? "▲" : "▼")
        mtfTxt = "chart" + f_arrow(mChart) + "  5m" + f_arrow(nz(m5)) + "  15m" + f_arrow(nz(m15)) + "  60m" + f_arrow(nz(m60)) + " · " + (structure > 0 ? "HH/HL" : structure < 0 ? "LH/LL" : "mixed")
        flowTxt = "CVD " + f_arrow(cvdZ > 0.5 ? 1 : cvdZ < -0.5 ? -1 : 0) + " z" + f_signed(cvdZ, "0.0") + " · Δ " + f_signed(barDelta, "0") + " (" + f_signed(deltaPct * 100, "0") + "%) · vol z " + str.tostring(volZ, "0.0")
        feedTxt = (na(rsZ) ? "ES n/a" : "NQ vs ES " + (rsZ > 0.2 ? "stronger" : rsZ < -0.2 ? "weaker" : "in line") + " (z" + f_signed(rsZ, "0.0") + ")") + " · TICK " + (na(tickAvg) ? "n/a" : f_signed(tickAvg, "0"))
        lvlTxt = (na(rPx) ? "R --" : "R " + f_name(rK) + " " + f_px(rPx) + " +" + str.tostring(math.round((rPx - close) / syminfo.mintick)) + "t") + " · " + (na(sPx) ? "S --" : "S " + f_name(sK) + " " + f_px(sPx) + " -" + str.tostring(math.round((close - sPx) / syminfo.mintick)) + "t")
        valTxt = na(poc) ? (na(pdPoc) ? "profile builds from the RTH open" : "pdPOC " + f_px(pdPoc) + " · pdVA " + f_px(pdVal) + "-" + f_px(pdVah)) : "POC " + f_px(poc) + " · VA " + f_px(vaLo) + "-" + f_px(vaHi) + " · " + (close > vaHi ? "above value" : close < vaLo ? "below value" : "inside value")
        stTxt = "window " + winTxt + " · signals " + str.tostring(tradesToday) + (maxTrades > 0 ? "/" + str.tostring(maxTrades) : "") + " · Δ " + (ltfOk ? ltfStr + "m bars" : "tick rule")
        f_cell(tbl, 0, 0, "NQ EDGE", cVwap, color.new(cPanel, 0), size.small)
        f_cell(tbl, 1, 0, " " + biasTxt + " ", cPanel, biasBg, size.normal)
        f_cell(tbl, 0, 1, "ACTION", cDim, cClear, size.small)
        f_cell(tbl, 1, 1, " " + act + " ", actFg, actBg, size.normal)
        f_cell(tbl, 0, 2, "PLAN", cDim, cClear, size.small)
        f_cell(tbl, 1, 2, plan, cGold, cClear, size.small)
        f_cell(tbl, 0, 3, "REGIME", cDim, cRow, size.small)
        f_cell(tbl, 1, 3, regTxt, regime == 1 ? cBull : regime == 2 ? cBear : cText, cRow, size.small)
        f_cell(tbl, 0, 4, "MTF", cDim, cClear, size.small)
        f_cell(tbl, 1, 4, mtfTxt, mtfBias > 0.1 ? cBull : mtfBias < -0.1 ? cBear : cText, cClear, size.small)
        f_cell(tbl, 0, 5, "FLOW", cDim, cRow, size.small)
        f_cell(tbl, 1, 5, flowTxt, cvdZ > 0.5 ? cBull : cvdZ < -0.5 ? cBear : cText, cRow, size.small)
        f_cell(tbl, 0, 6, "FEEDS", cDim, cClear, size.small)
        f_cell(tbl, 1, 6, feedTxt, cText, cClear, size.small)
        f_cell(tbl, 0, 7, "LEVELS", cDim, cRow, size.small)
        f_cell(tbl, 1, 7, lvlTxt, cVwap, cRow, size.small)
        f_cell(tbl, 0, 8, "VALUE", cDim, cClear, size.small)
        f_cell(tbl, 1, 8, valTxt, cGold, cClear, size.small)
        f_cell(tbl, 0, 9, "STATUS", cDim, cRow, size.tiny)
        f_cell(tbl, 1, 9, stTxt, cDim, cRow, size.tiny)

    // ---- performance panel: every setup's forward-tracked record and its gate state ----
    if showPerf
        f_cell(perf, 0, 0, "SETUP", cDim, cRow, size.tiny)
        f_cell(perf, 1, 0, "N", cDim, cRow, size.tiny)
        f_cell(perf, 2, 0, "WIN", cDim, cRow, size.tiny)
        f_cell(perf, 3, 0, "AVG R", cDim, cRow, size.tiny)
        f_cell(perf, 4, 0, "STATE", cDim, cRow, size.tiny)
        for st = 1 to 5
            w = array.get(statW, st)
            l = array.get(statL, st)
            n = w + l
            avg = n > 0 ? array.get(statR, st) / n : 0.0
            muted = gateOn and n >= gateN and avg < gateR
            f_cell(perf, 0, st, f_setupName(st), cText, cClear, size.tiny)
            f_cell(perf, 1, st, str.tostring(n), cText, cClear, size.tiny)
            f_cell(perf, 2, st, n > 0 ? str.tostring(100.0 * w / n, "0") + "%" : "--", cText, cClear, size.tiny)
            f_cell(perf, 3, st, n > 0 ? f_signed(avg, "0.00") : "--", n == 0 ? cDim : avg >= 0 ? cBull : cBear, cClear, size.tiny)
            f_cell(perf, 4, st, muted ? "MUTED" : n < gateN ? "LEARN" : "ON", muted ? cBear : n < gateN ? cDim : cBull, cClear, size.tiny)
        nS = shW + shL
        f_cell(perf, 0, 6, "SHOWN", cVwap, cRow, size.tiny)
        f_cell(perf, 1, 6, str.tostring(nS), cText, cRow, size.tiny)
        f_cell(perf, 2, 6, nS > 0 ? str.tostring(100.0 * shW / nS, "0") + "%" : "--", cText, cRow, size.tiny)
        f_cell(perf, 3, 6, nS > 0 ? f_signed(shR / nS, "0.00") : "--", nS == 0 ? cDim : shR >= 0 ? cBull : cBear, cRow, size.tiny)
        f_cell(perf, 4, 6, nS > 0 ? f_signed(shR, "0.0") + "R" : "--", nS == 0 ? cDim : shR >= 0 ? cBull : cBear, cRow, size.tiny)

// ═════════════════════════ Alerts (create with "Once Per Bar Close") ═════════════════════════
alertcondition(sigDir > 0 and sigShown, "NQ Edge LONG",  "NQ Edge LONG {{ticker}} @ {{close}}")
alertcondition(sigDir < 0 and sigShown, "NQ Edge SHORT", "NQ Edge SHORT {{ticker}} @ {{close}}")
if sigDir != 0 and sigShown
    alert("NQ Edge " + (sigDir > 0 ? "LONG " : "SHORT ") + (sigGrade == 1 ? "A " : "B ") + f_setupName(sigType) + " " + syminfo.ticker + " entry " + f_px(sigEntry) + " stop " + f_px(sigStop) + " T1 " + f_px(sigT1) + " T2 " + f_px(sigT2) + (sigSize > 0 ? " size " + str.tostring(sigSize) + "x" : ""), alert.freq_once_per_bar_close)
